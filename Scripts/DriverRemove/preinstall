#!/bin/zsh
set -euo pipefail
DRIVER_PATH="/Library/Audio/Plug-Ins/HAL/VanilleLatencyClock.driver"
if [[ ! -d "$DRIVER_PATH" || -L "$DRIVER_PATH" ]]; then
  print -u2 "The expected Vanille timing driver is absent or is a symbolic link. Nothing changed."
  exit 1
fi
DRIVER_ID="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$DRIVER_PATH/Contents/Info.plist")"
if [[ "$DRIVER_ID" != "com.avanturation.Vanille.LatencyClock" ]]; then
  print -u2 "Bundle identity does not match Vanille. Nothing changed."
  exit 1
fi
# Keep a recoverable copy outside the HAL directory instead of deleting the bundle.
BACKUP_ROOT="/Library/Audio/Plug-Ins/Vanille Disabled Drivers"
/bin/mkdir -p "$BACKUP_ROOT"
BACKUP_PATH="$BACKUP_ROOT/VanilleLatencyClock-$(/bin/date +%Y%m%d-%H%M%S).driver"
if [[ -e "$BACKUP_PATH" ]]; then
  print -u2 "A backup already exists at this timestamp. Nothing changed."
  exit 1
fi
/bin/mv "$DRIVER_PATH" "$BACKUP_PATH"
